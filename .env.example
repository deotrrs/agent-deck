# Copy this file to .env and adjust. Restart `npm run dev` after changing it.

# Folders that hold your projects, comma-separated. The first one is the primary.
# Every subfolder that is a git repo (or has a .claude folder / CLAUDE.md) shows up in the repo picker,
# grouped by folder name. "~" is expanded to your home folder.
# Default when unset: the parent folder of agent-deck.
PROJECTS_ROOTS=~/Documents/develop,~/dev

# Full path to the Claude Code CLI. Only needed if `claude` isn't on your PATH
# (for example with nvm). Find it with: which claude
# CLAUDE_BIN=/Users/you/.nvm/versions/node/v24.0.0/bin/claude
